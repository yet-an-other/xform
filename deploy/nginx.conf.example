# xform — proxy-hosted deployment shape (ADR-0001)
#
# nginx serves the built dashboard as static files and reverse-proxies the API
# to the xform binary on loopback, keeping UI and API same-origin (no CORS).
# The embedded default shape needs no nginx at all — this file is only for the
# proxy-hosted shape.

server {
    listen 443 ssl;
    server_name panel.example.net;

    # ssl_certificate     /etc/letsencrypt/live/panel.example.net/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/panel.example.net/privkey.pem;

    # Built dashboard (npm --prefix web run build; copy of internal/cmd/xform/dist).
    root /var/www/xform/dist;
    index index.html;

    location ^~ /api/ {
        # GOTCHA: no URI part on proxy_pass. With a URI (even just "/"), nginx
        # rewrites /api/v1/server to /v1/server and the API 404s.
        proxy_pass http://127.0.0.1:9090;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fingerprinted build assets are immutable; everything else revalidates.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}

# ── Subpath variant ──────────────────────────────────────────────────────────
# The dashboard is built mount-point agnostic (relative asset and API URLs),
# so the panel can hang under a subpath of an existing vhost. The API rewrite
# below is the one DELIBERATE exception to the no-URI gotcha above: it strips
# the /xform prefix. The bare /xform must redirect to /xform/, or the page's
# relative URLs resolve against the wrong directory.
#
# location = /xform { return 308 /xform/; }
# location /xform/api/ {
#     proxy_pass http://127.0.0.1:9090/api/;
#     proxy_set_header Host              $host;
#     proxy_set_header X-Real-IP         $remote_addr;
#     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
# location /xform/ {
#     alias /var/www/xform/dist/;
#     index index.html;
#     try_files $uri $uri/ /xform/index.html;
# }
