[Unit]
Description=xform — read-only monitoring panel for xray
After=xray.service

[Service]
Type=simple
ExecStart=/usr/local/bin/xform
Restart=on-failure
RestartSec=5

# The panel prefixes each log line with its sd-daemon priority. journald strips
# that prefix into PRIORITY, which keeps warning and error badges accurate.
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true

# Runs unprivileged: create the system user first (see README — useradd
# --system xform). Property reads on the D-Bus system bus and exec'ing the
# world-readable xray binary need no privileges; only root may touch
# /run/systemd/private, so that socket is just a fallback for root-run hosts.
User=xform

# Creates /var/lib/xform (default XFORM_DB location) owned by the system user.
StateDirectory=xform

# Roster applies rewrite the xray config file — a temp file in the same
# directory, then rename — so the config directory must be writable inside
# this sandbox: ProtectSystem=strict below mounts / (and so /usr/local/etc)
# read-only, and this whitelist is the only way through it. Keep it in step
# with XFORM_XRAY_CONFIG: a config in another location needs that directory
# here instead. The whitelist lifts only the mount-namespace wall — the
# xform user still needs DAC write access (setfacl, see README), and both
# are required for user management to apply.
ReadWritePaths=/usr/local/etc/xray

# Log snapshots. Both this unit and the configured xray service log into one
# dedicated journal namespace, and the xform user gets read ACLs on that
# namespace alone — never membership in systemd-journal, adm, or wheel, which
# would grant every journal on the host. The namespace is the boundary: any
# other unit assigned to it becomes readable by the panel.
#
# Consequence for admins: this unit's own records leave the default journal.
# Read them with `journalctl --namespace=xform -u xform.service`.
# Full procedure: docs/journal-namespace.md.
LogNamespace=xform

# Re-apply the namespace ACLs, as root, before the panel starts. Boot-time
# tmpfiles processing runs long before systemd-journald@xform creates the
# volatile /run/log/journal/<machine-id>.xform directory, so on a volatile host
# that pass has nothing to act on; by the time this runs, LogNamespace= above
# has already brought the namespace up. "+" runs it as root outside this unit's
# sandbox; "-" keeps a host that never ran the migration starting normally,
# with Log snapshots reporting their own error and nothing else affected.
ExecStartPre=-+/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/xform-journal-acl.conf

# Hardening. The panel needs exactly: read-only host /proc + /sys, the D-Bus
# system bus, a loopback listener, outbound loopback to the xray gRPC API,
# its writable StateDirectory, and write access to the xray config directory
# for roster applies (ReadWritePaths above — ProtectSystem=strict mounts
# everything else read-only).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
# AF_UNIX: D-Bus system bus · AF_INET/AF_INET6: loopback listener + xray gRPC.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Same-origin through a reverse proxy or SSH tunnel only; never expose directly.
Environment=XFORM_LISTEN=127.0.0.1:9090
# REQUIRED: the panel refuses to start without a login password.
# Environment=XFORM_PASSWORD=change-me
# Environment=XFORM_XRAY_API=127.0.0.1:8080
# XFORM_XRAY_CONFIG default is /usr/local/etc/xray/config.json; ReadWritePaths
# above must name its directory.
# Environment=XFORM_XRAY_CONFIG=/usr/local/etc/xray/config.json
# Environment=XFORM_DB=/var/lib/xform/xform.db
# Environment=XFORM_XRAY_UNIT=xray.service
# journalctl is exec'd for Log snapshots; the panel refuses to start when this
# path is not an absolute, executable, regular file. Override on distros that
# ship it elsewhere. The hardening above is deliberately not relaxed for it:
# a journalctl this sandbox cannot run costs the panel its Log snapshots only.
# Environment=XFORM_JOURNALCTL=/usr/bin/journalctl

[Install]
WantedBy=multi-user.target
