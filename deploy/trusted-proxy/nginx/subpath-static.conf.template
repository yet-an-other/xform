# xform Trusted proxy gateway — static Dashboard, /xform/ mount
#
# Render only the five deployment placeholders. nginx serves the built SPA
# from /var/www/xform/dist, keeps /xform/ in browser-facing URLs, and strips
# that prefix only on authenticated requests sent to xform. The raw
# $request_uri map preserves encoded User email bytes and query strings.

user ${NGINX_USER};
worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;

    map $request_uri $xform_upstream_uri {
        ~^/xform(?<xform_path>/.*)$ $xform_path;
        default "";
    }

    upstream xform_panel {
        server unix:${XFORM_SOCKET};
    }

    upstream oauth2_proxy {
        server ${OAUTH2_PROXY_UPSTREAM};
    }

    server {
        listen ${NGINX_LISTEN};
        server_name _;


        disable_symlinks on;

        # Configure TLS in the enclosing public vhost, or set NGINX_LISTEN to
        # "443 ssl" and add the certificate directives here.

        # oauth2-proxy is configured with --proxy-prefix=/xform/oauth2, so
        # keep the mount on these public and internal auth paths.
        location = /xform/oauth2/auth {
            internal;
            add_header Cache-Control "no-store" always;
            proxy_hide_header Cache-Control;
            proxy_pass http://oauth2_proxy;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header X-Auth-Request-Redirect $request_uri;
            proxy_set_header X-Forwarded-Uri $request_uri;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Xform-Authenticated "";
            proxy_set_header Authorization "";
            proxy_set_header Proxy-Authorization "";
        }

        location = /xform/oauth2 {
            add_header Cache-Control "no-store" always;
            return 308 /xform/oauth2/$is_args$args;
        }
        location ^~ /xform/oauth2/ {
            add_header Cache-Control "no-store" always;
            proxy_hide_header Cache-Control;
            proxy_pass http://oauth2_proxy;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Auth-Request-Redirect $request_uri;
        }

        location = /xform {
            return 308 /xform/$is_args$args;
        }

        location = /xform/api {
            auth_request /xform/oauth2/auth;
            error_page 401 = @xform_api_unauthorized;
            proxy_pass http://xform_panel$xform_upstream_uri;
        }
        location ^~ /xform/api/ {
            auth_request /xform/oauth2/auth;
            error_page 401 = @xform_api_unauthorized;
            proxy_pass http://xform_panel$xform_upstream_uri;
        }
        location @xform_api_unauthorized {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 401 '{"error":"unauthenticated"}';
        }

        # The alias is confined to the build root. Missing assets are 404s;
        # other missing documents receive the authenticated SPA fallback.
        location ^~ /xform/assets/ {
            auth_request /xform/oauth2/auth;
            error_page 401 = /xform/_xform_oauth2_start;
            alias /var/www/xform/dist/assets/;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }
        location ^~ /xform/ {
            auth_request /xform/oauth2/auth;
            error_page 401 = /xform/_xform_oauth2_start;
            alias /var/www/xform/dist/;
            index index.html;
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ /xform/index.html;
        }
        # Proxy the sign-in start internally so the original request URI can
        # travel in a header without being reparsed as a nested query string.
        location = /xform/_xform_oauth2_start {
            internal;
            add_header Cache-Control "no-store" always;
            proxy_hide_header Cache-Control;
            proxy_pass http://oauth2_proxy/xform/oauth2/start?;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Host $http_host;
            proxy_set_header X-Auth-Request-Redirect $request_uri;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Uri $request_uri;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Xform-Authenticated "";
            proxy_set_header Authorization "";
            proxy_set_header Proxy-Authorization "";
        }

        # Requests outside the declared mount do not become a second Panel
        # origin in a shared vhost.
        location / {
            return 404;
        }

        # Protected API hops overwrite every assertion, identity, token,
        # authorization, cookie, and forwarding header. auth_request completes
        # before these xform proxy settings can be used.
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Xform-Authenticated ${XFORM_TRUSTED_PROXY_SECRET};
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Uri "";
        proxy_set_header X-Forwarded-Method "";
        proxy_set_header X-Forwarded-Query "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-Protocol "";
        proxy_set_header X-Forwarded-Scheme "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Email "";
        proxy_set_header X-Forwarded-Groups "";
        proxy_set_header X-Forwarded-Preferred-Username "";
        proxy_set_header X-Forwarded-Access-Token "";
        proxy_set_header X-Forwarded-Authorization "";
        proxy_set_header X-Forwarded-Id-Token "";
        proxy_set_header X-Forwarded-IdToken "";
        proxy_set_header X-Forwarded-Client-Cert "";
        proxy_set_header X-Auth-Request-User "";
        proxy_set_header X-Auth-Request-Email "";
        proxy_set_header X-Auth-Request-Groups "";
        proxy_set_header X-Auth-Request-Preferred-Username "";
        proxy_set_header X-Auth-Request-Token "";
        proxy_set_header X-Auth-Request-Access-Token "";
        proxy_set_header X-Auth-Request-Redirect "";
        proxy_set_header X-Auth-Request-Id-Token "";
        proxy_set_header X-Auth-Request-IdToken "";
        proxy_set_header X-Auth-Request-Client-Cert "";
        proxy_set_header X-Access-Token "";
        proxy_set_header X-ID-Token "";
        proxy_set_header X-Id-Token "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Groups "";
        proxy_set_header X-Remote-User "";
        proxy_set_header X-Remote-Email "";
        proxy_set_header X-Remote-Groups "";
        proxy_set_header X-Authenticated-User "";
        proxy_set_header X-Authenticated-Email "";
        proxy_set_header X-Authenticated-Groups "";
        proxy_set_header X-Authenticated-Preferred-Username "";
        proxy_set_header X-Authenticated-Token "";
        proxy_set_header X-Authenticated-Access-Token "";
        proxy_set_header X-Authenticated-Authorization "";
        proxy_set_header X-Authenticated-Id-Token "";
        proxy_set_header X-Authenticated-IdToken "";
        proxy_set_header X-Authenticated-Client-Cert "";
        proxy_set_header X-User "";
        proxy_set_header X-Email "";
        proxy_set_header X-Groups "";
        proxy_set_header X-Group "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Original-URI "";
        proxy_set_header X-Original-Method "";
        proxy_set_header X-SSL-Client-Cert "";
        proxy_set_header X-Client-Cert "";
    }
}
